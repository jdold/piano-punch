---
const title = 'Piano Punch';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f8f5ee" />
    <title>{title} · Piano practice</title>
    <meta name="description" content="A calm, encouraging piano practice tracker for the whole family." />
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <a class="brand" href="#home" aria-label="Piano Punch home"><span class="brand-mark">♫</span><span>Piano <b>Punch</b></span></a>
        <button id="parent-toggle" class="parent-link" type="button">Parent controls <span id="cloud-status" class="sync-status">Loading…</span><span class="pending-pill"><span id="pending-count">0</span></span></button>
      </header>

      <section id="child-welcome" class="child-welcome" hidden>
        <div class="welcome-note">♫</div><p class="eyebrow">PIANO PUNCH</p><h1>Who’s practicing today?</h1>
        <p id="kid-link-message">Pick your name to open your practice space.</p><div id="kid-profile-buttons" class="kid-profile-buttons">Loading family profiles…</div>
      </section>

      <section class="hero" id="home">
        <div>
          <p class="eyebrow">YOUR PRACTICE SPACE</p>
          <h1>Small steps.<br /><em>Beautiful music.</em></h1>
          <p class="intro">Every practice session moves you forward.</p>
        </div>
        <div class="music-note note-one">♪</div><div class="music-note note-two">♫</div>
      </section>

      <section class="child-row" aria-label="Choose a child">
        <div class="child-identity"><div><p class="eyebrow">PLAYING TODAY</p><h2 id="child-label">Son</h2></div><button id="theme-toggle" class="theme-toggle" type="button" aria-label="Change profile colors" aria-expanded="false" aria-controls="theme-picker" title="Change colors">◒</button></div>
        <div id="child-picker" class="child-picker"></div>
        <button id="rename-child" class="icon-button" type="button" aria-label="Rename selected child" title="Rename">✎</button>
      </section>
      <div id="theme-picker" class="theme-picker" role="group" aria-label="Choose profile colors" hidden></div>

      <section class="practice-card" aria-labelledby="practice-heading">
        <div class="practice-top">
          <div><p class="eyebrow">TODAY'S PRACTICE</p><h2 id="practice-heading">You're doing great</h2></div>
          <div class="streak-badge"><span>✦</span><div><small>STREAK</small><strong id="streak-count">0 days</strong></div></div>
        </div>
        <div class="practice-main">
          <div class="goal-ring" id="goal-ring" aria-label="Daily goal progress"><div class="goal-ring-inner"><strong id="goal-ring-value">0%</strong><small>goal</small></div></div>
          <div class="goal-copy"><strong id="goal-label">0 / 20 min today</strong><p>You're building a lovely habit, one note at a time.</p><div class="points-line"><span class="star">✦</span><b id="point-total">0</b> points available <small id="points-earned">0 earned</small></div><div id="badges" class="badges"></div></div>
        </div>
        <div class="practice-footer"><span>Active practice today</span><strong id="today-active">00:00</strong></div>
      </section>

      <section class="session-card" aria-labelledby="session-heading">
        <div class="session-title"><div><p class="eyebrow">YOUR PRACTICE SESSION</p><h2 id="session-heading">Ready when you are</h2></div><span class="live-pill" id="live-state" data-state="ready" aria-live="polite"><i></i>Ready</span></div>
        <div class="session-timers" id="session-detail" hidden>
          <div class="live-ring-wrap"><div id="live-ring" class="live-ring"><span>♫</span></div><small id="session-credit-note">Verified active time</small></div>
          <div class="timer-numbers"><div><small>PLAYING TIME</small><strong id="session-active">00:00</strong><small>Counts toward today’s goal</small></div><div><small>SESSION DURATION</small><strong id="session-elapsed">00:00</strong><small>Since punch in</small></div><div><small>GOAL LEFT</small><strong id="session-remaining">20:00</strong></div></div>
        </div>
        <p id="screen-status" class="screen-status" aria-live="polite"></p>
        <p id="permission-message" class="notice" hidden></p>
        <p id="session-hint" class="session-hint">The microphone stays off until your child punches in.</p>
        <button id="retry-audio" class="small-button retry-audio" type="button" hidden>Try microphone again</button>
        <div class="punch-row"><button class="punch-button" id="punch-in" type="button">Punch in <span>→</span></button><button class="punch-button" id="manual-pause" type="button" hidden>Pause timer <span>Ⅱ</span></button><button class="punch-button punch-out" id="punch-out" type="button" disabled>Punch out <span>■</span></button></div>
        <div class="state-legend"><span><i class="dot playing"></i>Playing</span><span><i class="dot grace"></i>Grace period</span><span><i class="dot paused"></i>Paused</span></div>
      </section>

      <section class="lower-grid">
        <section class="panel rewards-panel">
          <div class="panel-heading"><div><p class="eyebrow">LITTLE WINS</p><h2>Rewards to work toward</h2></div><span class="panel-icon">✧</span></div>
          <div id="reward-progress" class="reward-list"></div>
        </section>
        <section class="panel history-panel">
          <div class="panel-heading"><div><p class="eyebrow">YOUR JOURNEY</p><h2>Recent practice</h2></div><span class="panel-icon">⌁</span></div>
          <ul id="history-list" class="history-list"></ul>
        </section>
      </section>

      <section class="panel parent-dashboard" id="parent-dashboard" hidden>
        <div class="panel-heading"><div><p class="eyebrow">PARENT CONTROLS</p><h2>Family dashboard</h2></div><span class="panel-icon">⚙</span></div>
        <p class="prototype-note">You’re signed in through Cloudflare Access. Practice data syncs to D1; optional recordings are private in R2.</p>
        <div class="parent-grid">
          <div class="admin-block"><h3>Children</h3><div id="parent-children"></div></div>
          <div class="admin-block"><h3>Practice and points</h3><form id="goal-form" class="compact-form"><label>Daily active goal <span><input id="goal-input" type="number" min="1" max="180" /> min</span></label><label>Pause threshold <span><input id="threshold-input" type="number" min="5" max="120" /> sec</span></label><label class="recording-setting"><input id="recording-enabled" type="checkbox" /> Save private session recordings for parent audits</label><label>Daily completion points <input id="daily-points" type="number" min="0" /></label><label>Weekly lesson points <input id="lesson-points" type="number" min="0" /></label><label>Practice day points <input id="practice-points" type="number" min="0" /></label><label>Extra minutes step <span><input id="extra-step" type="number" min="1" /> min</span></label><label>Points per extra step <input id="extra-points" type="number" min="0" /></label><div class="milestone-inputs"><label>3d <input id="milestone-3" type="number" min="0" /></label><label>5d <input id="milestone-5" type="number" min="0" /></label><label>7d <input id="milestone-7" type="number" min="0" /></label><label>14d <input id="milestone-14" type="number" min="0" /></label><label>30d <input id="milestone-30" type="number" min="0" /></label></div><fieldset class="weekday-settings"><legend>Required practice days</legend><label><input type="checkbox" value="1" class="weekday-check" /> Mon</label><label><input type="checkbox" value="2" class="weekday-check" /> Tue</label><label><input type="checkbox" value="3" class="weekday-check" /> Wed</label><label><input type="checkbox" value="4" class="weekday-check" /> Thu</label><label><input type="checkbox" value="5" class="weekday-check" /> Fri</label><label><input type="checkbox" value="6" class="weekday-check" /> Sat</label><label><input type="checkbox" value="0" class="weekday-check" /> Sun</label></fieldset><button class="small-button">Save settings</button></form><form id="excuse-form" class="compact-form"><label>Excuse / vacation day <input type="date" id="excuse-date" required /></label><input id="excuse-reason" placeholder="Reason (optional)" /><button class="small-button">Add rest day</button></form><div id="excused-list"></div></div>
          <div class="admin-block detector-admin"><h3>Instrument detection tuning</h3><p class="muted">Choose this child above. Adjustments save automatically and affect their practice timer.</p><label class="detector-select">Instrument <select id="instrument-input"><option value="acoustic_piano">Acoustic piano</option><option value="digital_keyboard">Digital keyboard</option><option value="cello">Cello</option><option value="other">Other instrument</option></select></label><label class="range-setting">Minimum mic level <span id="mic-volume-value"></span><input id="mic-volume" type="range" min="0.001" max="0.02" step="0.0005" /></label><label class="range-setting">Lowest pitch <span id="pitch-low-value"></span><input id="pitch-low" type="range" min="40" max="400" step="5" /></label><label class="range-setting">Highest pitch <span id="pitch-high-value"></span><input id="pitch-high" type="range" min="400" max="3000" step="25" /></label><label class="range-setting">Harmonic content <span id="harmonicity-value"></span><input id="harmonicity" type="range" min="0.1" max="0.7" step="0.01" /></label><label class="range-setting">Detection confidence <span id="confidence-value"></span><input id="confidence" type="range" min="0.4" max="0.95" step="0.01" /></label><div class="detector-test"><button id="detector-test-toggle" class="small-button" type="button">Start live test</button><strong id="detector-test-state" data-detected="false" aria-live="polite">Test is off</strong><small id="detector-test-metrics"></small><p>Speak, then play. This tunes the current pitch/harmonic heuristic—not a trained instrument recognizer. Some voices may still match. It records no audio and adds no practice time.</p></div></div>
          <div class="admin-block"><h3>Rewards</h3><form id="reward-form" class="compact-form"><input id="reward-id" type="hidden" /><input id="reward-name" placeholder="Reward name" required /><input id="reward-description" placeholder="Description" /><input id="reward-image" type="url" placeholder="Optional image URL" /><label>Point cost <input id="reward-cost" type="number" min="1" required /></label><input id="reward-restrictions" placeholder="Optional restriction" /><div class="actions"><button id="reward-submit" class="small-button">Add reward</button><button id="reward-cancel" class="small-button" type="button" hidden>Cancel</button></div></form><div id="reward-admin-list"></div></div>
          <div class="admin-block"><h3>Pending requests</h3><div id="redemption-list"></div></div>
          <div class="admin-block"><h3>Points adjustment</h3><form id="adjust-form" class="compact-form"><input id="adjust-points" type="number" placeholder="+ / − points" required /><input id="adjust-note" placeholder="Reason" required /><button class="small-button">Save adjustment</button></form><div class="ledger-wrap"><ul id="ledger-list" class="history-list"></ul></div></div>
          <div class="admin-block"><h3>Special achievement</h3><form id="special-form" class="compact-form"><input id="special-name" placeholder="Achievement" required /><input id="special-points" type="number" min="1" placeholder="Points" required /><button class="small-button">Award points</button></form></div>
          <div class="admin-block"><h3>Practice timeline and corrections</h3><div id="session-audit-list"></div><h3 class="add-session-heading">Add a missed practice</h3><form id="add-session-form" class="compact-form session-entry-form"><label>Start <input id="add-session-start" type="datetime-local" required /></label><label>End <input id="add-session-end" type="datetime-local" required /></label><label>Credited playing minutes <input id="add-session-active" type="number" min="0" step="0.1" required /></label><input id="add-session-reason" placeholder="Reason for adding this session" required /><button class="small-button">Add practice time</button></form></div>
        </div>
      </section>

      <footer><span>Made for family practice</span><span>♫</span><span>One note at a time</span></footer>
    </main>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <section class="goal-celebration" id="goal-celebration" role="dialog" aria-modal="true" aria-labelledby="celebration-title" hidden>
      <div class="firework" aria-hidden="true">✦　✧　✦　✧　✦</div>
      <p class="eyebrow">GOAL COMPLETE</p><h2 id="celebration-title">You did it! 🎉</h2>
      <p id="celebration-copy">You reached today’s playing goal. Great job!</p>
      <p class="bonus-copy" id="celebration-bonus"></p>
      <div class="celebration-actions"><button id="continue-bonus" class="punch-button" type="button">Keep playing for bonus points</button><button id="end-after-goal" class="small-button" type="button">End practice now</button></div>
    </section>
  </body>
</html>

<script>
  import '../styles/global.css';
  import '../lib/app.js';
</script>

<style is:global>
  .sync-status { margin-left: 5px; color: #7b867e; font-size: 9px; font-weight: 500; }
  .live-pill[data-state="starting"] { background: #edf1f7; color: #52667f; }
  .live-pill[data-state="starting"] i { background: #6684ad; animation: mic-pulse 1s ease-in-out infinite; }
  .live-pill[data-state="ready"] i { background: #aeb5ab; }
  .retry-audio { margin: 0 0 12px; }
  .session-edit-form { display: grid; gap: 8px; margin: 10px 0; padding: 10px; border-radius: 10px; background: #f7f5ef; }
  .session-edit-form label { display: grid; gap: 4px; color: #6f7c73; font-size: 10px; }
  .session-edit-form input { min-width: 0; border: 1px solid #e2dfd5; border-radius: 7px; padding: 8px; background: white; }
  .add-session-heading { margin-top: 18px !important; }
  .session-entry-form { margin-top: 10px; }
  #manual-pause { background: #66886a; }
  .punch-button[hidden], .retry-audio[hidden] { display: none !important; }
  @keyframes mic-pulse { 50% { opacity: .3; transform: scale(.75); } }
  @media (prefers-reduced-motion: reduce) { .live-pill[data-state="starting"] i { animation: none; } }
</style>
